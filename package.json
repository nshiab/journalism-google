{
  "name": "@nshiab/journalism-google",
  "version": "2.0.2",
  "description": "Useful TypeScript functions for journalism projects. This library focuses on accessing Google services.",
  "homepage": "https://nshiab.github.io/journalism-google/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nshiab/journalism-google.git"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "llm.md",
    "llms.txt"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "login": "gcloud auth application-default login",
    "fix": "vp check --fix",
    "docs": "typedoc --gitRevision v$npm_package_version && node scripts/docs.ts",
    "all-tests": "vp check && vp test && vp pack && npm run docs",
    "preversion": "node scripts/check-release-branch.ts && npm run all-tests",
    "version": "npm run docs && git add docs llm.md llms.txt",
    "postversion": "git push --atomic origin HEAD \"v$npm_package_version\"",
    "patch": "npm version patch",
    "minor": "npm version minor",
    "major": "npm version major"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "google-auth-library": "^11.2.0",
    "google-spreadsheet": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typedoc": "0.28.20",
    "typedoc-github-theme": "0.4.0",
    "typedoc-plugin-llms-txt": "0.1.2",
    "typedoc-plugin-markdown": "4.14.0",
    "typescript": "6.0.3",
    "vite-plus": "1.2.0"
  },
  "engines": {
    "node": ">=24.21.0"
  }
}
